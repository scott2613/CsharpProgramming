@model ComputerStore.API.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Xác nhận tài khoản - DTBStore";
}
@await Html.PartialAsync("_AccountLegacyStyles")
<div class="container py-4 store-auth-scope auth-forgot">
    <div class="auth-card">
        <div class="text-center mb-4 auth-heading"><h2>XÁC NHẬN TÀI KHOẢN</h2></div>
        <p>Nhập tài khoản có vai trò Khách hàng (Customer). Bạn sẽ cần mật khẩu hiện tại ở bước tiếp theo.</p>
        @if (TempData["PasswordChangeNotice"] is string notice)
        {
            <div class="alert-cyber-warning" role="status">@notice</div>
        }
        <form asp-action="ForgotPassword" method="post">
            <label asp-for="Identifier" class="form-label-cyber">Tên đăng nhập, email hoặc số điện thoại</label>
            <input asp-for="Identifier" class="form-control-cyber" autocomplete="username" maxlength="100" required />
            <span asp-validation-for="Identifier" class="validation-text" role="alert"></span>
            <button type="submit" class="btn-auth">TIẾP TỤC</button>
        </form>
        <div class="text-center mt-4 auth-bottom"><a asp-action="Login" class="auth-link">← Quay lại Đăng nhập</a></div>
    </div>
</div>
