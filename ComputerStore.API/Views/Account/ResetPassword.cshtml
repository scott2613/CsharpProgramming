@model ComputerStore.API.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu - DTBStore";
}
@await Html.PartialAsync("_AccountLegacyStyles")
<div class="container py-4 store-auth-scope auth-forgot">
    <div class="auth-card">
        <div class="text-center mb-4 auth-heading"><h2>ĐẶT LẠI MẬT KHẨU</h2></div>
        <div asp-validation-summary="ModelOnly" class="cyber-alert-danger" role="alert"></div>
        @if (!string.IsNullOrEmpty(Model.Token))
        {
            <form asp-action="ResetPassword" method="post">
                <input asp-for="Token" type="hidden" />
                <label asp-for="NewPassword" class="form-label-cyber">Mật khẩu mới</label>
                <input asp-for="NewPassword" class="form-control-cyber" type="password" autocomplete="new-password" minlength="8" required />
                <span asp-validation-for="NewPassword" class="validation-text"></span>
                <label asp-for="ConfirmPassword" class="form-label-cyber">Xác nhận mật khẩu</label>
                <input asp-for="ConfirmPassword" class="form-control-cyber" type="password" autocomplete="new-password" minlength="8" required />
                <span asp-validation-for="ConfirmPassword" class="validation-text"></span>
                <button type="submit" class="btn-auth">LƯU MẬT KHẨU MỚI</button>
            </form>
        }
        <div class="text-center mt-4 auth-bottom"><a asp-action="ForgotPassword" class="auth-link">← Quay lại Quên mật khẩu</a></div>
    </div>
</div>
