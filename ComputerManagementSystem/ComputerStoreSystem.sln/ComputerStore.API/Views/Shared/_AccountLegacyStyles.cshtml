<style>

    .store-auth-scope {
        --bg-dark: #080c0d;
        --card-dark: #0e1516;
        --card-inner: #141f21;
        --card-border: #1e453e;
        --neon-cyan: #5df2d6;
        --neon-glow: rgba(93,242,214,.25);
        --text-sub: #8da4a4;
        box-sizing: border-box;
        width: 100%;
        max-width: 520px;
        margin: 0 auto;
        padding: 24px 12px;
        color: #fff;
        font-family: 'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;
    }

        .store-auth-scope *, .store-auth-scope *::before, .store-auth-scope *::after {
            box-sizing: border-box;
        }

        .store-auth-scope .auth-card {
            background: var(--card-dark);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 35px;
            max-width: 440px;
            margin: 20px auto 40px;
            box-shadow: 0 0 30px rgba(93,242,214,.12);
            transition: border-color .25s ease;
        }

            .store-auth-scope .auth-card:hover {
                border-color: rgba(93,242,214,.4);
            }

        .store-auth-scope.auth-login .auth-card {
            margin: 0;
            max-width: 100%;
            width: 100%;
        }

        .store-auth-scope.auth-register {
            max-width: 620px;
        }

            .store-auth-scope.auth-register .auth-card {
                max-width: 520px;
                margin: 40px auto;
            }

        .store-auth-scope.auth-change {
            max-width: 560px;
        }

            .store-auth-scope.auth-change .auth-card {
                max-width: 460px;
                margin: 50px auto;
                border-radius: 14px;
            }

        .store-auth-scope.auth-forgot .auth-card {
            margin: 40px auto;
        }

        .store-auth-scope .auth-heading {
            text-align: center;
            margin-bottom: 24px;
        }

            .store-auth-scope .auth-heading h2 {
                color: var(--neon-cyan);
                font-weight: 800;
                letter-spacing: 1px;
                font-size: 1.75rem;
                margin: 0 0 8px;
            }

            .store-auth-scope .auth-heading p, .store-auth-scope .auth-heading small {
                color: var(--text-sub);
                font-size: 13.5px;
                margin: 0;
            }

        .store-auth-scope .btn-back-circle {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: rgba(93,242,214,.08);
            border: 1.5px solid var(--neon-cyan);
            color: var(--neon-cyan);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 19px;
            box-shadow: 0 0 10px rgba(93,242,214,.15);
            transition: all .25s ease;
            flex-shrink: 0;
        }

            .store-auth-scope .btn-back-circle:hover {
                background: var(--neon-cyan);
                color: var(--bg-dark);
                box-shadow: 0 0 16px rgba(93,242,214,.4);
                transform: scale(1.08);
            }

        .store-auth-scope .auth-back {
            margin-bottom: 16px;
        }

        .store-auth-scope .form-label-cyber {
            color: var(--text-sub);
            font-size: 13px;
            margin: 0 0 4px;
            display: block;
        }

        .store-auth-scope.auth-change .form-label-cyber {
            font-size: .88rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .3px;
            margin-bottom: 6px;
        }

        .store-auth-scope .form-control-cyber {
            background-color: var(--card-inner) !important;
            border: 1px solid var(--card-border) !important;
            color: #fff !important;
            border-radius: 6px;
            padding: 12px 14px;
            width: 100%;
            margin: 0 0 5px;
            outline: none;
            font-family: inherit;
            font-size: 1rem;
            transition: border-color .2s, box-shadow .2s;
        }

        .store-auth-scope.auth-change .form-control-cyber {
            border-width: 1.5px !important;
            border-radius: 8px;
            padding: 12px 16px;
            font-weight: 600;
        }

        .store-auth-scope .form-control-cyber:focus {
            border-color: var(--neon-cyan) !important;
            box-shadow: 0 0 10px rgba(93,242,214,.4);
        }

        .store-auth-scope .form-control-cyber.input-validation-error {
            border-color: #ff5370 !important;
            box-shadow: 0 0 8px rgba(255,83,112,.4);
        }

        .store-auth-scope input.form-control-cyber:-webkit-autofill {
            -webkit-text-fill-color: #fff;
            box-shadow: 0 0 0 1000px #141f21 inset;
            caret-color: #fff;
        }

        .store-auth-scope .password-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            margin-bottom: 5px;
            width: 100%;
        }

            .store-auth-scope .password-wrapper input {
                margin-bottom: 0 !important;
                padding-right: 50px !important;
            }

        .store-auth-scope .btn-toggle-eye {
            position: absolute;
            right: 10px;
            background: transparent;
            border: none;
            color: var(--neon-cyan);
            cursor: pointer;
            padding: 6px 10px;
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1;
            text-shadow: 0 0 10px #5df2d6,0 0 20px rgba(93,242,214,.8);
            transition: transform .2s ease,text-shadow .2s ease;
        }

            .store-auth-scope .btn-toggle-eye:hover {
                color: #fff;
                transform: scale(1.18);
                text-shadow: 0 0 15px #5df2d6,0 0 30px #5df2d6;
            }

            .store-auth-scope .btn-toggle-eye:focus-visible {
                outline: 2px solid var(--neon-cyan);
                border-radius: 5px;
            }

        .store-auth-scope .btn-auth, .store-auth-scope .btn-update {
            background: linear-gradient(135deg,#00796b,#004d40);
            border: 1px solid var(--neon-cyan);
            color: #fff;
            font-weight: 700;
            padding: 12px 0;
            width: 100%;
            border-radius: 6px;
            cursor: pointer;
            transition: all .25s ease;
            margin-top: 10px;
            letter-spacing: .5px;
            font-family: inherit;
        }

            .store-auth-scope .btn-auth:hover:not(:disabled), .store-auth-scope .btn-update:hover {
                background: var(--neon-cyan);
                color: var(--bg-dark);
                box-shadow: 0 0 14px rgba(93,242,214,.5);
            }

            .store-auth-scope .btn-auth:disabled {
                opacity: .55;
                cursor: not-allowed;
            }

        .store-auth-scope .btn-update {
            border-width: 1.5px;
            border-radius: 8px;
            margin: 0;
        }

            .store-auth-scope .btn-update:hover {
                transform: translateY(-2px);
            }

        .store-auth-scope .btn-cancel {
            display: block;
            background: transparent;
            border: 1.5px solid var(--card-border);
            color: var(--text-sub);
            font-weight: 700;
            padding: 12px 0;
            border-radius: 8px;
            text-decoration: none;
            text-align: center;
            transition: all .2s ease;
        }

            .store-auth-scope .btn-cancel:hover {
                border-color: #f87171;
                color: #f87171;
                background: rgba(248,113,113,.1);
            }

        .store-auth-scope .auth-actions {
            display: flex;
            gap: 16px;
            margin-top: 24px;
        }

            .store-auth-scope .auth-actions > * {
                flex: 1;
                min-width: 0;
            }

        .store-auth-scope .validation-text {
            color: #ff5370;
            font-size: 12.5px;
            display: block;
            margin: 2px 0 14px;
        }

        .store-auth-scope .alert-cyber-danger, .store-auth-scope .cyber-alert-danger {
            background: rgba(239,68,68,.15);
            border: 1px solid #f87171;
            color: #fca5a5;
            border-radius: 8px;
            padding: 12px 14px;
            font-size: 13.5px;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .store-auth-scope .validation-summary-valid {
            display: none;
        }

        .store-auth-scope .cyber-alert-danger ul {
            margin: 0;
            padding-left: 20px;
        }

        .store-auth-scope .alert-cyber-warning {
            background: rgba(234,179,8,.15);
            border: 1px solid #eab308;
            color: #fef08a;
            border-radius: 8px;
            padding: 12px 14px;
            font-size: 13.5px;
            margin-bottom: 20px;
        }

        .store-auth-scope .alert-cyber-success {
            background: rgba(52,211,153,.2);
            border: 1px solid #34d399;
            color: #34d399;
            font-size: 13.5px;
            border-radius: 8px;
            padding: 8px 14px;
            margin-bottom: 16px;
        }

        .store-auth-scope .auth-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            font-size: 13px;
            margin: 0 0 16px;
        }

            .store-auth-scope .auth-options label {
                color: var(--text-sub);
                cursor: pointer;
                display: inline-flex;
                gap: 6px;
                align-items: center;
            }

        .store-auth-scope input[type=checkbox] {
            accent-color: var(--neon-cyan);
        }

        .store-auth-scope a.auth-link {
            color: var(--neon-cyan);
            text-decoration: none;
            font-weight: 700;
        }

            .store-auth-scope a.auth-link:hover {
                text-decoration: underline;
            }

        .store-auth-scope .auth-bottom {
            text-align: center;
            margin-top: 24px;
            padding-top: 18px;
            font-size: 13.5px;
            color: var(--text-sub);
            border-top: 1px solid #142826;
        }

        .store-auth-scope.auth-register .auth-bottom {
            border-top: 0;
            padding-top: 0;
            margin-top: 16px;
        }

        .store-auth-scope.auth-forgot .auth-bottom {
            padding-top: 15px;
        }

        .store-auth-scope .auth-fields-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

            .store-auth-scope .auth-fields-row > div {
                flex: 1;
                min-width: 0;
            }

    @@media(max-width:767px) {
        .store-auth-scope .auth-card {
            padding: 26px 20px;
        }

        .store-auth-scope .auth-fields-row {
            display: block;
        }

        .store-auth-scope .auth-heading h2 {
            font-size: 1.5rem;
        }
    }

    @@media(prefers-reduced-motion:reduce) {
        .store-auth-scope * {
            transition: none !important;
        }
    }

</style>
