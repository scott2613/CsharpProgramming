@model ComputerStore.API.Models.ChangePasswordViewModel
@{
    var ticket = ViewBag.PasswordChangeTicket as string;
    ViewData["Title"] = "Đổi mật khẩu - BMDTStore";
}
@await Html.PartialAsync("_AccountLegacyStyles")

<div class="container py-4 store-auth-scope auth-change">
    <div class="auth-card">
        <div class="text-center mb-4 auth-heading">
            <h2 style="letter-spacing: -.02em;"><i class="bi bi-shield-lock me-2"></i>ĐỔI MẬT KHẨU</h2>
            <small>Nhập mật khẩu hiện tại và mật khẩu mới</small>
        </div>
        <div asp-validation-summary="ModelOnly" class="cyber-alert-danger" role="alert"></div>
        <form action="@Url.Action(ticket is null ? "ChangePassword" : "ChangePasswordWithAccount", "Account")" method="post">
            @Html.AntiForgeryToken()
            @if (ticket is not null)
            {
                <input type="hidden" name="ticket" value="@ticket" />
            }
            <label for="oldPass" class="form-label-cyber">Mật khẩu hiện tại</label>
            <div class="password-wrapper">
                <input asp-for="OldPassword" type="password" id="oldPass" class="form-control-cyber" placeholder="Nhập mật khẩu đang dùng" required autocomplete="current-password" />
                <button type="button" class="btn-toggle-eye" data-password-target="oldPass" aria-label="Hiện mật khẩu hiện tại" aria-pressed="false"><i id="eyeOld" class="bi bi-eye-fill" aria-hidden="true"></i></button>
            </div>
            <span asp-validation-for="OldPassword" class="validation-text"></span>
            <label for="newPass" class="form-label-cyber">Mật khẩu mới</label>
            <div class="password-wrapper">
                <input asp-for="NewPassword" type="password" id="newPass" class="form-control-cyber" placeholder="Tối thiểu 8 ký tự" required minlength="8" maxlength="128" autocomplete="new-password" />
                <button type="button" class="btn-toggle-eye" data-password-target="newPass" aria-label="Hiện mật khẩu mới" aria-pressed="false"><i id="eyeNew" class="bi bi-eye-fill" aria-hidden="true"></i></button>
            </div>
            <span asp-validation-for="NewPassword" class="validation-text"></span>
            <label for="confirmPass" class="form-label-cyber">Xác nhận lại mật khẩu mới</label>
            <div class="password-wrapper">
                <input asp-for="ConfirmPassword" type="password" id="confirmPass" class="form-control-cyber" placeholder="Nhập lại mật khẩu mới" required autocomplete="new-password" data-password-confirm="newPass" />
                <button type="button" class="btn-toggle-eye" data-password-target="confirmPass" aria-label="Hiện xác nhận mật khẩu" aria-pressed="false"><i id="eyeConfirm" class="bi bi-eye-fill" aria-hidden="true"></i></button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="validation-text"></span>
            <div class="d-flex gap-3 mt-4 auth-actions">
                <a asp-controller="Account" asp-action="@(ticket is null ? "Profile" : "ForgotPassword")" class="btn-cancel w-50">HỦY</a>
                <button type="submit" class="btn-update w-50"><i class="bi bi-check2 me-1"></i> CẬP NHẬT</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @await Html.PartialAsync("_AccountLegacyScripts")
}
