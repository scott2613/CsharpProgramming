@model ComputerStore.API.Models.ForgotPasswordEmailViewModel
@{
    ViewData["Title"] = "Quên mật khẩu - DTBStore";
}
@await Html.PartialAsync("_AccountLegacyStyles")
<div class="container py-4 store-auth-scope auth-forgot">
    <div class="auth-card">
        <div class="text-center mb-4 auth-heading"><h2>QUÊN MẬT KHẨU</h2></div>
        @if (TempData["ResetNotice"] is string notice)
        {
            <div class="alert-cyber-warning" role="status">@notice</div>
        }
        <p>Nhập email đã đăng ký. Liên kết đặt lại mật khẩu có hiệu lực trong 20 phút.</p>
        @if (ViewBag.UsesLocalInbox == true)
        {
            <p>Hãy khởi động Mailpit. Sau khi gửi liên kết, mở <a class="auth-link" href="http://127.0.0.1:8025/">hộp thư thử nghiệm</a> để đọc email.</p>
        }
        @if (ViewBag.MailEnabled != true)
        {
            <div class="alert-cyber-warning" role="status">
                Dịch vụ gửi email đặt lại mật khẩu chưa được cấu hình. Vui lòng thử lại sau.
            </div>
        }
        <form asp-action="ForgotPasswordRequest" method="post">
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <label asp-for="Email" class="form-label-cyber">Email đã đăng ký</label>
            <input asp-for="Email" class="form-control-cyber" type="email" autocomplete="email" required />
            <span asp-validation-for="Email" class="validation-text"></span>
            <button type="submit" class="btn-auth" disabled="@(ViewBag.MailEnabled != true)">GỬI LIÊN KẾT</button>
        </form>
        <div class="text-center mt-4 auth-bottom"><a asp-action="ForgotPassword" class="auth-link">← Quay lại Quên mật khẩu</a></div>
    </div>
</div>
